const $=s=>document.querySelector(s);let me=null,servers=[];
async function api(url,opts={}){const r=await fetch('/api'+url,{...opts,headers:{...(opts.body instanceof FormData?{}:{'Content-Type':'application/json'}),...(opts.headers||{})}});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}
function msg(s){alert(s)}
function showLogin(){ $('#login').classList.remove('hidden');$('#app').classList.add('hidden');}
function showApp(){ $('#login').classList.add('hidden');$('#app').classList.remove('hidden');$('#who').textContent=me.username+' · '+me.role;$('#role').textContent=me.role.toUpperCase();$('#welcome').textContent=me.username;document.querySelectorAll('.admin-only').forEach(x=>x.classList.toggle('hidden',me.role!=='admin'));load();}
$('#loginForm').addEventListener('submit',async e=>{e.preventDefault();$('#loginError').textContent='';const f=new FormData(e.target);try{await api('/login',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});me=(await api('/me')).user;showApp()}catch(err){$('#loginError').textContent=err.message}});
$('#logout').onclick=async()=>{await api('/logout',{method:'POST'});me=null;showLogin()};
async function init(){try{me=(await api('/me')).user;if(me)showApp();else showLogin()}catch{showLogin()}}
async function load(){try{const d=await api('/dashboard');servers=d.servers;$('#stats').innerHTML=`<div class="stat"><i>▣</i><b>${d.stats.total}</b><span>Total Servers</span></div><div class="stat"><i style="color:#16e69a">▶</i><b>${d.stats.running}</b><span>Running</span></div><div class="stat"><i style="color:#ff456b">■</i><b>${d.stats.stopped}</b><span>Stopped</span></div><div class="stat"><i>◈</i><b>${d.stats.ramTotalMB} MB</b><span>Host RAM</span></div>`;render('dashboard')}catch(e){msg(e.message)}}
function serverCards(){return servers.map(s=>`<article class="server-card"><div class="section-head"><h3>▣ ${esc(s.name)}</h3><span class="pill ${s.running?'':'off'}">${s.running?'● Running':'● Stopped'}</span></div><div class="muted small">${esc(s.software)} · Port ${s.port} · ${s.ram} MB RAM</div><div class="muted small">${s.jarUploaded?'server.jar uploaded':'No server.jar uploaded'}</div><div class="actions"><button onclick="control('${s.id}','start')">▶ Start</button><button onclick="control('${s.id}','stop')">■ Stop</button><button onclick="openConsole('${s.id}')">Console</button>${me.role==='admin'?`<button onclick="uploadJar('${s.id}')">Upload JAR</button><button onclick="removeServer('${s.id}')">Delete</button>`:''}</div></article>`).join('')||'<div class="notice">No servers yet. Ask an administrator to create one.</div>'}
function render(page){document.querySelectorAll('nav a').forEach(a=>a.classList.toggle('active',a.dataset.page===page));let c=$('#content');if(page==='dashboard'||page==='servers'){c.innerHTML=`<div class="section-head"><h2>${page==='dashboard'?'Your Servers':'Server Management'}</h2>${me.role==='admin'?'<button class="primary" id="newServer">＋ Create Server</button>':''}</div><div class="server-grid">${serverCards()}</div>`;const b=$('#newServer');if(b)b.onclick=()=>$('#modal').classList.remove('hidden')}
else if(page==='console'){c.innerHTML=`<div class="panel"><h2>Live Console</h2><p class="muted">Choose a server to view output and send Minecraft commands.</p><select id="consoleSelect">${servers.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('')}</select><div class="console" id="consoleOut">Select a server.</div><form class="console-form" id="commandForm"><input name="command" placeholder="Enter Minecraft command (without /)"><button class="primary">Send</button></form></div>`;if(servers.length)openConsole(servers[0].id);$('#commandForm').onsubmit=async e=>{e.preventDefault();const id=$('#consoleSelect').value;try{await api(`/servers/${id}/command`,{method:'POST',body:JSON.stringify({command:new FormData(e.target).get('command')})});e.target.reset()}catch(err){msg(err.message)}};$('#consoleSelect').onchange=e=>openConsole(e.target.value)}
else if(page==='users'){c.innerHTML=`<div class="panel"><div class="section-head"><h2>User Management</h2></div><form id="userForm" class="two"><label>Username<input name="username" required minlength="3"></label><label>Temporary password<input name="password" type="password" minlength="10" required></label><button class="primary">Create User</button></form><div id="userList" class="notice">Loading users…</div></div>`;loadUsers()}
else if(page==='system'){c.innerHTML='<div class="panel"><h2>System Monitor</h2><div id="systemInfo">Loading…</div></div>';api('/system').then(x=>$('#systemInfo').innerHTML=`<p>Host: ${esc(x.hostname)}</p><p>Platform: ${esc(x.platform)}</p><p>CPU cores: ${x.cpu}</p><p>RAM: ${Math.round(x.ramFree/1048576)} MB free / ${Math.round(x.ramTotal/1048576)} MB total</p><p>Load average: ${x.load.map(n=>n.toFixed(2)).join(', ')}</p><p>Disk: ${x.diskNote}</p>`).catch(e=>msg(e.message))}
else c.innerHTML='<div class="panel"><h2>Settings</h2><p class="muted">Panel settings and security options will be added in a later release. Change credentials and session secret in the server .env file.</p></div>'}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function control(id,action){try{await api(`/servers/${id}/${action}`,{method:'POST',body:'{}'});await load()}catch(e){msg(e.message)}}
async function removeServer(id){if(!confirm('Delete this server and its files? This cannot be undone.'))return;try{await api('/servers/'+id,{method:'DELETE'});await load()}catch(e){msg(e.message)}}
async function uploadJar(id){const inp=document.createElement('input');inp.type='file';inp.accept='.jar';inp.onchange=async()=>{if(!inp.files[0])return;const fd=new FormData();fd.append('jar',inp.files[0]);try{await api(`/servers/${id}/jar`,{method:'POST',body:fd});await load();msg('JAR uploaded.')}catch(e){msg(e.message)}};inp.click()}
async function openConsole(id){if($('#consoleSelect'))$('#consoleSelect').value=id;try{const d=await api(`/servers/${id}/logs`);if($('#consoleOut'))$('#consoleOut').textContent=d.logs.map(x=>`[${new Date(x.time).toLocaleTimeString()}] ${x.line}`).join('\n')||'No output yet.';if($('#consoleOut'))$('#consoleOut').scrollTop=$('#consoleOut').scrollHeight}catch(e){msg(e.message)}}
async function loadUsers(){try{const d=await api('/users');$('#userList').innerHTML=d.users.map(u=>`<div class="notice">${esc(u.username)} · ${u.role} · ${u.servers.length} assigned server(s)</div>`).join('');$('#userForm').onsubmit=async e=>{e.preventDefault();try{await api('/users',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});e.target.reset();loadUsers()}catch(err){msg(err.message)}}}catch(e){msg(e.message)}}
document.querySelectorAll('nav a').forEach(a=>a.onclick=e=>{e.preventDefault();render(a.dataset.page)});
$('#closeModal').onclick=()=>$('#modal').classList.add('hidden');
$('#createForm').onsubmit=async e=>{e.preventDefault();$('#createError').textContent='';const f=new FormData(e.target);const data=Object.fromEntries(f);data.eula=f.get('eula')==='on';data.port=Number(data.port);data.ram=Number(data.ram);try{await api('/servers',{method:'POST',body:JSON.stringify(data)});$('#modal').classList.add('hidden');e.target.reset();await load()}catch(err){$('#createError').textContent=err.message}};
init();setInterval(()=>{if(me&&$('#content').textContent.includes('Live Console')){const id=$('#consoleSelect')?.value;if(id)openConsole(id)}},3000);
